{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": [
    "api/**/*.ts",
    "server.ts",
    "database.ts",
    "agents/**/*.ts",
    "utils/**/*.ts",
    "types/**/*.ts",
    "tests/**/*.ts",
    "public/js/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "public"
  ]
}
